# Copy to .env for local development. Set production values in Render's Environment tab.
# Placeholders only: never commit real credentials.
NODE_ENV=development
PORT=3000
SITE_NAME=VN Booking Hub
SITE_URL=http://localhost:4200
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Neon: use the pooled URL for the running API; use a direct URL for migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/real_estate
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

BOOKING_TOKEN_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Defaults to 1 on Render and 0 locally. Set explicitly only if your proxy chain differs.
TRUST_PROXY_HOPS=
CORS_ORIGINS=
INTERNAL_API_KEY=
JOBS_ENABLED=true

# Turnstile requires matching TURNSTILE_SITE_KEY in the website build.
# Keep empty for local development; set in production after deploying the website site key.
# Cloudflare's published test secrets are refused in production.
TURNSTILE_SECRET_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=10
OVERLOAD_LAG_MS=300
ADMIN_SESSION_HOURS=12
BOOKING_HOLD_MINUTES=30

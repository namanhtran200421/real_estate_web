# Copy to `.env` for local development: cp .env.example .env
# In production, set these in the hosting platform instead of shipping a .env file.
# Variables marked (required) have no default; the others show their default.
# Generate secrets with: openssl rand -base64 48

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Run background jobs (emails, payment checks, hold expiry) in this process.
# With several instances, keeping it on everywhere is safe: each run is locked in the database.
JOBS_ENABLED=true

# --- Public addresses (required; https:// in production) -----------------------
# The website. Links in emails point here.
SITE_URL=http://localhost:4200
SITE_NAME=VN Booking Hub
# Defines "today", night dates and the database session time zone.
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Network / security --------------------------------------------------------
# Number of reverse proxies in front of the app (load balancer, CDN), used to read the real
# client IP for rate limiting. 0 when the app is exposed directly. Never set it higher than
# the real number of proxies: clients could then fake their IP and bypass rate limits.
TRUST_PROXY_HOPS=0
# Extra browser origins allowed to call the API, comma-separated. SITE_URL is always allowed.
CORS_ORIGINS=
# Shared secret the website's server sends when it renders pages, so its requests are not
# rate limited per IP. Set the same value in the frontend's environment. Optional, min 32 chars.
INTERNAL_API_KEY=

# --- Database (PostgreSQL 13+) -------------------------------------------------
# (required) postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate
# Connections per app instance. Keep (instances × DB_POOL_MAX) below Postgres max_connections.
DB_POOL_MAX=10
# Postgres cancels any query running longer than this (milliseconds).
DB_STATEMENT_TIMEOUT_MS=5000
# true for managed databases that require TLS (Neon, RDS, Supabase, …).
DB_SSL=false

# --- Rate limiting (per client IP) ---------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
# Max requests of any kind per window.
RATE_LIMIT_MAX=120
# Max anonymous POST/PUT/PATCH/DELETE requests per window (bookings, transfer reports, contact form).
RATE_LIMIT_WRITE_MAX=10

# --- Bookings ------------------------------------------------------------------
# How long a new booking holds its dates for the guest to transfer. Once the guest reports the
# transfer, the dates stay held until the owner confirms or rejects it.
BOOKING_HOLD_MINUTES=30
# (required, min 32 chars) Signs guests' booking access links. Changing it logs every guest
# out of their booking pages (they can use the lookup form again).
BOOKING_TOKEN_SECRET=

# --- Admin ---------------------------------------------------------------------
# Lifetime of an owner/staff login.
ADMIN_SESSION_HOURS=12

# --- Email (Resend) ------------------------------------------------------------
# Required in production. Without it (development) emails are printed to the log.
RESEND_API_KEY=
# (required) Sender; its domain must be verified in Resend.
EMAIL_FROM=VN Booking Hub <datphong@example.com>
# (required) Receives "please check this transfer" and contact-form alerts.
OWNER_EMAIL=haihoangdo14112004@gmail.com

# --- Payments: bank transfer (VietQR) ------------------------------------------
# (all required) The account guests transfer to. The payment page shows a VietQR code with this
# account, the amount and the booking reference filled in; the owner confirms each transfer in
# the admin area, which confirms the booking.
# BIN = the bank's NAPAS code: Vietcombank 970436, Techcombank 970407, BIDV 970418,
# VietinBank 970415, MB 970422, ACB 970416, Agribank 970405, TPBank 970423, VPBank 970432.
BANK_BIN=970436
BANK_NAME=Vietcombank
BANK_ACCOUNT_NUMBER=6969888821
BANK_ACCOUNT_NAME=DO HOANG HAI

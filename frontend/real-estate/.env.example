# Copy to .env for local development. On Vercel, set these in the project settings.
# Placeholders only: never commit real values.

# Build time (bundled into browser code, so public by nature).
API_URL=http://localhost:3000
# Cloudflare Turnstile site key; must pair with the API's TURNSTILE_SECRET_KEY. Empty = no CAPTCHA.
# Local testing only: 1x00000000000000000000AA (never use on Vercel production).
TURNSTILE_SITE_KEY=

# Runtime, server only (never sent to browsers).
INTERNAL_API_KEY=
SERVER_API_URL=

# Copy to `.env` for local development: cp .env.example .env
# On Vercel (or any host), set these as environment variables of the project.

# --- Build time (bundled into the browser code; must be public) ---------------
# Public URL of the backend API.
API_URL=http://localhost:3000

# --- Runtime, server-side rendering only (never sent to browsers) --------------
# Same value as the backend's INTERNAL_API_KEY, so page rendering is not rate limited
# as if every visitor were one client. Optional but recommended in production.
INTERNAL_API_KEY=
# URL the rendering server uses to reach the API, if different from API_URL
# (e.g. a private network address). Optional.
SERVER_API_URL=
